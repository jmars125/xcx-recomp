#version 450
// Ambient occlusion, passes 2 and 3 of 3 (vk_ao.c): a depth-aware blur of pass 1's occlusion, across then down. A tap
// counts less the further its distance is from the pixel's own, so the occlusion of a near object does not spread onto
// the ground far behind it (the dark halos of a plain blur, as in the game's own two blur passes). Pass 2 writes the
// same layout as pass 1 (occlusion, distance); pass 3 writes the final occlusion into r of an RGBA8 image.
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 3) uniform sampler2D in_tex;   // occlusion in r, distance in g; nearest
layout(binding = 2) uniform writeonly image2D out_img;   // RG16F (RGBA16F where that is no storage image): written without a format
layout(binding = 6, rgba8) uniform writeonly image2D final_img;
layout(push_constant) uniform P {
    vec4 proj;
    vec4 look;
    vec2 size;
    float max_px;
    float bias;
    vec2 dir;        // (1, 0) across, (0, 1) down
    float last;      // 1: write final_img, 0: out_img
    float sharp;     // how fast a tap's weight falls with its relative distance
} pc;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= int(pc.size.x) || p.y >= int(pc.size.y)) return;
    vec2 px = 1.0 / pc.size;
    vec2 uv = (vec2(p) + 0.5) * px;
    vec2 c = textureLod(in_tex, uv, 0.0).rg;
    float sum = c.r, w = 1.0;
    for (int i = -4; i <= 4; i++) {   // enough to hide the per-pixel rotation, narrow enough to keep contact lines
        if (i == 0) continue;
        vec2 s = textureLod(in_tex, uv + pc.dir * float(i) * px, 0.0).rg;
        float g = exp(-float(i * i) / 8.0);   // gaussian, sigma 2 taps
        float k = g * exp(-pc.sharp * abs(s.g - c.g) / max(c.g, 1e-3));
        sum += s.r * k, w += k;
    }
    float ao = sum / w;
    if (pc.last > 0.5) imageStore(final_img, p, vec4(ao, 0.0, 0.0, 1.0));
    else imageStore(out_img, p, vec4(ao, c.g, 0.0, 0.0));
}
